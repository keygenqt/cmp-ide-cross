<idea-plugin>
    <id>com.keygenqt.cmp.plugin</id>
    <name>Cross Demo</name>
    <vendor url="https://keygenqt.com/">KeyGenQt</vendor>
    <description><![CDATA[
        A single Kotlin Multiplatform + Compose Multiplatform UI, rendered natively
        across the IDE, VS Code, desktop, and the browser.
    ]]></description>

    <!-- Core platform dependencies -->
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.java</depends>

    <!-- Localization messages bundle -->
    <resource-bundle>messages.MessageBundle</resource-bundle>

    <!-- Plugin lifecycle listener for IDE startup events -->
    <applicationListeners>
        <listener class="com.keygenqt.cmp.plugin.PluginLifecycle"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

    <!-- Plugin extensions: notification group and tool window -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="com.keygenqt.cmp.plugin" displayType="BALLOON" key="toolwindow.stripe.Sidebar"/>
        <toolWindow id="Sidebar" factoryClass="com.keygenqt.cmp.plugin.PluginSidebar"/>
    </extensions>

    <!-- Kotlin K2 mode support -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
